---
interface Props {
  size?: "marketing" | "nav";
}

const { size = "marketing" } = Astro.props;
---

<span
  class:list={[
    "text-foreground inline-flex items-center font-extrabold tracking-tight",
    size === "marketing" && "text-[32px] leading-none",
    size === "nav" && "text-[26px] leading-none",
  ]}
>
  Saved
  <svg
    class:list={[size === "marketing" ? "ml-1 h-10 w-[19px]" : "ml-0.5 h-9 w-[17px]"]}
    viewBox="0 0 76 122"
    fill="none"
    aria-hidden="true"
  >
    <rect x="27" y="6" width="18" height="58" rx="9" fill="#2f9e6a"></rect>
    <circle cx="36" cy="96" r="23" fill="#2f9e6a"></circle>
    <path d="M27 97 L34 105 L48 88" stroke="#fffdf8" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round"
    ></path>
  </svg>
</span>
