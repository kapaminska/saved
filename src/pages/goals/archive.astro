---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { getSupabase } from "@/lib/supabase";

const { user } = Astro.locals;

const supabase = getSupabase(Astro.locals, Astro.request.headers, Astro.cookies);

const [{ data: completedGoals }, { data: abandonedGoals }] =
  supabase && user
    ? await Promise.all([
        supabase
          .from("savings_goals")
          .select("*")
          .eq("user_id", user.id)
          .eq("status", "completed")
          .order("completed_at", { ascending: false }),
        supabase
          .from("savings_goals")
          .select("*")
          .eq("user_id", user.id)
          .eq("status", "abandoned")
          .order("updated_at", { ascending: false }),
      ])
    : [{ data: [] }, { data: [] }];

function formatPln(amount: number): string {
  return `${amount.toFixed(2)} zł`;
}

function formatDate(value: string | null): string {
  if (!value) return "—";
  return new Date(value).toLocaleDateString("pl-PL");
}
---

<Layout title="Goal archive">
  <div class="bg-cosmic min-h-screen">
    <div class="relative z-10 p-4 sm:p-8">
      <Topbar />
      <div class="mx-auto mt-8 max-w-2xl">
        <a href="/dashboard" class="mb-4 inline-block text-sm text-purple-300 transition-colors hover:text-purple-100">
          ← Back to dashboard
        </a>
        <h1 class="mb-8 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Goal archive
        </h1>

        <section class="mb-10">
          <div class="mb-4 flex items-center gap-2">
            <h2 class="text-xl font-semibold text-white">Completed</h2>
            <span class="rounded-full border border-green-500/40 bg-green-900/30 px-2 py-0.5 text-xs text-green-300">
              {completedGoals?.length ?? 0}
            </span>
          </div>
          {
            completedGoals && completedGoals.length > 0 ? (
              <ul class="space-y-3">
                {completedGoals.map((goal) => (
                  <li class="rounded-xl border border-green-500/20 bg-white/10 p-4 text-white backdrop-blur-xl">
                    <div class="flex items-start justify-between gap-4">
                      <div>
                        <h3 class="font-medium text-white">{goal.name}</h3>
                        <p class="mt-1 text-sm text-blue-100/70">
                          {formatPln(goal.saved_amount)} / {formatPln(goal.target_amount)}
                        </p>
                      </div>
                      <span class="shrink-0 text-xs text-green-300">{formatDate(goal.completed_at)}</span>
                    </div>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="rounded-xl border border-white/10 bg-white/5 p-4 text-sm text-blue-100/50">
                No completed goals yet.
              </p>
            )
          }
        </section>

        <section>
          <div class="mb-4 flex items-center gap-2">
            <h2 class="text-xl font-semibold text-white">Abandoned</h2>
            <span class="rounded-full border border-white/20 bg-white/5 px-2 py-0.5 text-xs text-blue-100/60">
              {abandonedGoals?.length ?? 0}
            </span>
          </div>
          {
            abandonedGoals && abandonedGoals.length > 0 ? (
              <ul class="space-y-3">
                {abandonedGoals.map((goal) => (
                  <li class="rounded-xl border border-white/10 bg-white/5 p-4 text-white/80 backdrop-blur-xl">
                    <div class="flex items-start justify-between gap-4">
                      <div>
                        <h3 class="font-medium text-white/90">{goal.name}</h3>
                        <p class="mt-1 text-sm text-blue-100/50">
                          {formatPln(goal.saved_amount)} / {formatPln(goal.target_amount)}
                        </p>
                      </div>
                      <span class="shrink-0 text-xs text-blue-100/40">{formatDate(goal.updated_at)}</span>
                    </div>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="rounded-xl border border-white/10 bg-white/5 p-4 text-sm text-blue-100/50">
                No abandoned goals.
              </p>
            )
          }
        </section>
      </div>
    </div>
  </div>
</Layout>
