---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { getSupabase } from "@/lib/supabase";

const { user } = Astro.locals;

const supabase = getSupabase(Astro.locals, Astro.request.headers, Astro.cookies);

const [{ data: completedGoals }, { data: abandonedGoals }] =
  supabase && user
    ? await Promise.all([
        supabase
          .from("savings_goals")
          .select("*")
          .eq("user_id", user.id)
          .eq("status", "completed")
          .order("completed_at", { ascending: false }),
        supabase
          .from("savings_goals")
          .select("*")
          .eq("user_id", user.id)
          .eq("status", "abandoned")
          .order("updated_at", { ascending: false }),
      ])
    : [{ data: [] }, { data: [] }];

function formatPln(amount: number): string {
  return `${amount.toFixed(2)} zł`;
}

function formatDate(value: string | null): string {
  if (!value) return "—";
  return new Date(value).toLocaleDateString("pl-PL");
}
---

<Layout title="Goal archive">
  <div class="bg-warm min-h-screen">
    <div class="relative z-10 p-4 sm:p-8">
      <Topbar />
      <div class="mx-auto mt-8 max-w-2xl">
        <a href="/dashboard" class="text-primary hover:text-primary/80 mb-4 inline-block text-sm transition-colors">
          ← Back to dashboard
        </a>
        <h1 class="text-foreground mb-8 text-3xl font-bold">Goal archive</h1>

        <section class="mb-10">
          <div class="mb-4 flex items-center gap-2">
            <h2 class="text-foreground text-xl font-semibold">Completed</h2>
            <span class="rounded-full border border-green-200 bg-green-100 px-2 py-0.5 text-xs text-green-800">
              {completedGoals?.length ?? 0}
            </span>
          </div>
          {
            completedGoals && completedGoals.length > 0 ? (
              <ul class="space-y-3">
                {completedGoals.map((goal) => (
                  <li class="bg-card rounded-xl border border-green-200 p-4 shadow-sm">
                    <div class="flex items-start justify-between gap-4">
                      <div>
                        <h3 class="text-foreground font-medium">{goal.name}</h3>
                        <p class="text-muted-foreground mt-1 text-sm">
                          {formatPln(goal.saved_amount)} / {formatPln(goal.target_amount)}
                        </p>
                      </div>
                      <span class="shrink-0 text-xs text-green-700">{formatDate(goal.completed_at)}</span>
                    </div>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="border-border bg-muted/50 text-muted-foreground rounded-xl border p-4 text-sm">
                No completed goals yet.
              </p>
            )
          }
        </section>

        <section>
          <div class="mb-4 flex items-center gap-2">
            <h2 class="text-foreground text-xl font-semibold">Abandoned</h2>
            <span class="border-border bg-muted text-muted-foreground rounded-full border px-2 py-0.5 text-xs">
              {abandonedGoals?.length ?? 0}
            </span>
          </div>
          {
            abandonedGoals && abandonedGoals.length > 0 ? (
              <ul class="space-y-3">
                {abandonedGoals.map((goal) => (
                  <li class="border-border bg-muted/30 rounded-xl border p-4">
                    <div class="flex items-start justify-between gap-4">
                      <div>
                        <h3 class="text-foreground font-medium">{goal.name}</h3>
                        <p class="text-muted-foreground mt-1 text-sm">
                          {formatPln(goal.saved_amount)} / {formatPln(goal.target_amount)}
                        </p>
                      </div>
                      <span class="text-muted-foreground/70 shrink-0 text-xs">{formatDate(goal.updated_at)}</span>
                    </div>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="border-border bg-muted/50 text-muted-foreground rounded-xl border p-4 text-sm">
                No abandoned goals.
              </p>
            )
          }
        </section>
      </div>
    </div>
  </div>
</Layout>
