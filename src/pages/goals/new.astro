---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import GoalForm from "@/components/goals/GoalForm";
---

<Layout title="New goal">
  <div class="bg-warm min-h-screen">
    <div class="relative z-10 p-4 sm:p-8">
      <Topbar />
      <div class="mx-auto mt-8 max-w-md">
        <a href="/dashboard" class="text-primary hover:text-primary/80 mb-4 inline-block text-sm transition-colors">
          ← Back to dashboard
        </a>
        <div class="border-border bg-card rounded-2xl border p-8 shadow-lg">
          <h1 class="text-foreground mb-6 text-center text-2xl font-bold">New savings goal</h1>
          <GoalForm mode="create" initial={null} client:load />
        </div>
      </div>
    </div>
  </div>
</Layout>
