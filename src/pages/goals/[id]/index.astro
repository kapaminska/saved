---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import GoalStatusBadge from "@/components/goals/GoalStatusBadge";
import GoalQuickPayment from "@/components/goals/GoalQuickPayment";
import PaymentHistory from "@/components/goals/PaymentHistory";
import ClientRedirect from "@/components/goals/ClientRedirect";
import { getGoalDetailPageData } from "@/lib/goals/detail-page";
import { formatMonthYear } from "@/lib/i18n/format";
import { formatMonthsOfData } from "@/lib/goals/projection";

const { user } = Astro.locals;
const pageData = await getGoalDetailPageData(
  Astro.locals.supabase,
  Astro.request.headers,
  Astro.cookies,
  user?.id,
  Astro.params.id ?? "",
);

const now = new Date();
const defaultMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;

function formatPln(amount: number): string {
  return `${amount.toFixed(2)} zł`;
}

function formatDeadline(value: string | null): string {
  if (!value) return "";
  return formatMonthYear(value);
}

function progressPercent(saved: number, target: number): number {
  if (target <= 0) return 0;
  return Math.min(saved / target, 1) * 100;
}

const statusLabel: Record<string, string> = {
  active: "Aktywne",
  completed: "Ukończone",
  abandoned: "Porzucone",
};
---

{
  pageData.kind === "redirect" ? (
    <ClientRedirect url={pageData.url} client:load />
  ) : (
    <Layout title={pageData.goal.name}>
      <div class="bg-warm min-h-screen">
        <div class="relative z-10 p-4 sm:p-8">
          <Topbar />
          <div class="mx-auto mt-8 max-w-2xl">
            <a href="/dashboard" class="text-primary hover:text-primary/80 mb-4 inline-block text-sm transition-colors">
              ← Wróć do panelu
            </a>

            <div class="border-border bg-card mb-6 rounded-2xl border p-6 shadow-sm">
              <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <h1 class="text-foreground text-2xl font-bold">{pageData.goal.name}</h1>
                    {pageData.metrics.status && <GoalStatusBadge status={pageData.metrics.status} />}
                  </div>
                  <p class="text-muted-foreground mt-1 text-sm">
                    {statusLabel[pageData.goal.status] ?? pageData.goal.status}
                  </p>
                </div>
                {pageData.editable && (
                  <div class="flex shrink-0 items-center gap-2">
                    <GoalQuickPayment
                      goalId={pageData.goal.id}
                      goalName={pageData.goal.name}
                      defaultMonth={defaultMonth}
                      client:load
                    />
                    <a
                      href={`/goals/${pageData.goal.id}/edit`}
                      class="text-primary hover:text-primary/80 text-sm transition-colors"
                    >
                      Edytuj cel
                    </a>
                  </div>
                )}
              </div>

              <p class="text-muted-foreground mb-1 text-sm">
                {formatPln(pageData.goal.saved_amount)} / {formatPln(pageData.goal.target_amount)}
              </p>
              {pageData.goal.deadline && (
                <p class="text-muted-foreground/70 mb-3 text-xs">Termin: {formatDeadline(pageData.goal.deadline)}</p>
              )}

              <div class="bg-muted mb-1 h-2 overflow-hidden rounded-full">
                <div
                  class="bg-primary h-full rounded-full transition-all"
                  style={`width: ${progressPercent(pageData.goal.saved_amount, pageData.goal.target_amount)}%`}
                />
              </div>

              <div class="text-muted-foreground/80 mt-4 space-y-1 text-xs">
                {pageData.metrics.requiredPace != null && (
                  <p>Wymagane tempo: {formatPln(pageData.metrics.requiredPace)}/mies.</p>
                )}
                {pageData.metrics.projectedCompletionDate && (
                  <p>
                    Prognoza: {formatMonthYear(pageData.metrics.projectedCompletionDate)}
                    <span class="text-muted-foreground/60">
                      (na podstawie {formatMonthsOfData(pageData.metrics.monthsOfData)} danych)
                    </span>
                  </p>
                )}
              </div>
            </div>

            <section>
              <h2 class="text-foreground mb-3 text-lg font-semibold">Historia wpłat</h2>
              {!pageData.editable && (
                <p class="text-muted-foreground mb-3 text-sm">Tylko do odczytu — ten cel nie jest już aktywny.</p>
              )}
              <PaymentHistory
                goalId={pageData.goal.id}
                payments={pageData.payments.map((p) => ({
                  id: p.id,
                  amount: p.amount,
                  payment_month: p.payment_month,
                }))}
                editable={pageData.editable}
                client:load
              />
            </section>
          </div>
        </div>
      </div>
    </Layout>
  )
}
