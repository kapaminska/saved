---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import GoalStatusBadge from "@/components/goals/GoalStatusBadge";
import GoalQuickPayment from "@/components/goals/GoalQuickPayment";
import PaymentHistory from "@/components/goals/PaymentHistory";
import ClientRedirect from "@/components/goals/ClientRedirect";
import { getGoalDetailPageData } from "@/lib/goals/detail-page";
import { formatMonthsOfData } from "@/lib/goals/projection";

const { user } = Astro.locals;
const pageData = await getGoalDetailPageData(
  Astro.locals.supabase,
  Astro.request.headers,
  Astro.cookies,
  user?.id,
  Astro.params.id ?? "",
);

const now = new Date();
const defaultMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;

function formatPln(amount: number): string {
  return `${amount.toFixed(2)} zł`;
}

function formatDeadline(value: string | null): string {
  if (!value) return "";
  return formatProjectedMonth(value);
}

function formatProjectedMonth(value: string): string {
  const [year, month] = value.split("-");
  const date = new Date(Number(year), Number(month) - 1, 1);
  return date.toLocaleDateString("en-GB", { month: "long", year: "numeric" });
}

function progressPercent(saved: number, target: number): number {
  if (target <= 0) return 0;
  return Math.min(saved / target, 1) * 100;
}

const statusLabel: Record<string, string> = {
  active: "Active",
  completed: "Completed",
  abandoned: "Abandoned",
};
---

{
  pageData.kind === "redirect" ? (
    <ClientRedirect url={pageData.url} client:load />
  ) : (
    <Layout title={pageData.goal.name}>
      <div class="bg-cosmic min-h-screen">
        <div class="relative z-10 p-4 sm:p-8">
          <Topbar />
          <div class="mx-auto mt-8 max-w-2xl">
            <a
              href="/dashboard"
              class="mb-4 inline-block text-sm text-purple-300 transition-colors hover:text-purple-100"
            >
              ← Back to dashboard
            </a>

            <div class="mb-6 rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
              <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
                      {pageData.goal.name}
                    </h1>
                    {pageData.metrics.status && <GoalStatusBadge status={pageData.metrics.status} />}
                  </div>
                  <p class="mt-1 text-sm text-blue-100/60">
                    {statusLabel[pageData.goal.status] ?? pageData.goal.status}
                  </p>
                </div>
                {pageData.editable && (
                  <div class="flex shrink-0 items-center gap-2">
                    <GoalQuickPayment
                      goalId={pageData.goal.id}
                      goalName={pageData.goal.name}
                      defaultMonth={defaultMonth}
                      client:load
                    />
                    <a
                      href={`/goals/${pageData.goal.id}/edit`}
                      class="text-sm text-purple-300 transition-colors hover:text-purple-100"
                    >
                      Edit goal
                    </a>
                  </div>
                )}
              </div>

              <p class="mb-1 text-sm text-blue-100/70">
                {formatPln(pageData.goal.saved_amount)} / {formatPln(pageData.goal.target_amount)}
              </p>
              {pageData.goal.deadline && (
                <p class="mb-3 text-xs text-blue-100/50">Deadline: {formatDeadline(pageData.goal.deadline)}</p>
              )}

              <div class="mb-1 h-2 overflow-hidden rounded-full bg-white/10">
                <div
                  class="h-full rounded-full bg-gradient-to-r from-blue-400 to-purple-400 transition-all"
                  style={`width: ${progressPercent(pageData.goal.saved_amount, pageData.goal.target_amount)}%`}
                />
              </div>

              <div class="mt-4 space-y-1 text-xs text-blue-100/60">
                {pageData.metrics.requiredPace != null && (
                  <p>Required pace: {formatPln(pageData.metrics.requiredPace)}/mo</p>
                )}
                {pageData.metrics.projectedCompletionDate && (
                  <p>
                    Projected completion: {formatProjectedMonth(pageData.metrics.projectedCompletionDate)}
                    <span class="text-blue-100/40">
                      (based on {formatMonthsOfData(pageData.metrics.monthsOfData)} of data)
                    </span>
                  </p>
                )}
              </div>
            </div>

            <section>
              <h2 class="mb-3 text-lg font-semibold text-white">Payment history</h2>
              {!pageData.editable && (
                <p class="mb-3 text-sm text-blue-100/50">Read-only — this goal is no longer active.</p>
              )}
              <PaymentHistory
                goalId={pageData.goal.id}
                payments={pageData.payments.map((p) => ({
                  id: p.id,
                  amount: p.amount,
                  payment_month: p.payment_month,
                }))}
                editable={pageData.editable}
                client:load
              />
            </section>
          </div>
        </div>
      </div>
    </Layout>
  )
}
