---
import Layout from "@/layouts/Layout.astro";
import ProfileForm from "@/components/profile/ProfileForm";

const { profile } = Astro.locals;
---

<Layout title="Welcome">
  <div class="bg-warm flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-card w-full max-w-md rounded-2xl border p-8 shadow-lg">
      <h1 class="text-foreground mb-2 text-center text-2xl font-bold">Welcome!</h1>
      <p class="text-muted-foreground mb-6 text-center text-sm">
        Tell us a bit about yourself to personalize your experience.
      </p>

      <ProfileForm
        profile={{
          display_name: profile?.display_name ?? null,
          date_of_birth: profile?.date_of_birth ?? null,
          retirement_age: profile?.retirement_age ?? null,
          relationship_status: profile?.relationship_status ?? null,
        }}
        redirectTo="/dashboard"
        submitLabel="Continue"
        client:load
      />

      <div class="mt-4 text-center">
        <form method="POST" action="/api/profile/skip">
          <button type="submit" class="text-muted-foreground hover:text-foreground text-sm transition-colors">
            Skip for now
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>
