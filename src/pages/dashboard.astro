---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import CelebrationModal from "@/components/goals/CelebrationModal";
import CheckInModal from "@/components/goals/CheckInModal";
import GoalQuickPayment from "@/components/goals/GoalQuickPayment";
import GoalStatusBadge from "@/components/goals/GoalStatusBadge";
import NetWorthPanel from "@/components/net-worth/NetWorthPanel";
import { computeNetWorth, getNetWorthHeadline, getStalestAsset, isAssetStale } from "@/lib/net-worth/compute";
import { getSupabase } from "@/lib/supabase";
import { computeGoalMetrics, formatMonthsOfData, type GoalMetrics } from "@/lib/goals/projection";

const { user, profile } = Astro.locals;
const greeting = profile?.display_name ?? user?.email;

const supabase = getSupabase(Astro.locals, Astro.request.headers, Astro.cookies);
const celebratedGoalId = Astro.url.searchParams.get("celebrated");

const now = new Date();
const defaultMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;

interface ActiveGoal {
  id: string;
  name: string;
  saved_amount: number;
  target_amount: number;
  deadline: string | null;
  created_at: string;
}

let activeGoals: ActiveGoal[] = [];
let paymentsByGoal: Record<string, { amount: number; payment_month: string }[]> = {};
let metricsByGoal: Record<string, GoalMetrics> = {};
let celebratedGoalName: string | null = null;

interface NetWorthAsset {
  id: string;
  name: string;
  amount: number;
  category: string;
  last_updated_at: string;
}

interface NetWorthLiability {
  id: string;
  name: string;
  amount: number;
}

let netWorthAssets: NetWorthAsset[] = [];
let netWorthLiabilities: NetWorthLiability[] = [];
let netWorth = 0;
let netWorthHeadline = getNetWorthHeadline(profile?.relationship_status ?? null);
let stalestAsset: { id: string; name: string; lastUpdatedAt: string } | null = null;
let hasNetWorthItems = false;

if (supabase && user) {
  const { data } = await supabase
    .from("savings_goals")
    .select("id, name, saved_amount, target_amount, deadline, created_at")
    .eq("user_id", user.id)
    .eq("status", "active")
    .order("created_at", { ascending: false });

  activeGoals = data ?? [];

  const goalIds = activeGoals.map((g) => g.id);
  if (goalIds.length > 0) {
    const { data: payments } = await supabase
      .from("goal_payments")
      .select("goal_id, amount, payment_month")
      .in("goal_id", goalIds);

    for (const payment of payments ?? []) {
      const list = paymentsByGoal[payment.goal_id] ?? [];
      list.push({ amount: payment.amount, payment_month: payment.payment_month });
      paymentsByGoal[payment.goal_id] = list;
    }

    for (const goal of activeGoals) {
      metricsByGoal[goal.id] = computeGoalMetrics(goal, paymentsByGoal[goal.id] ?? []);
    }
  }

  if (celebratedGoalId) {
    const celebrated =
      activeGoals.find((g) => g.id === celebratedGoalId) ??
      (
        await supabase
          .from("savings_goals")
          .select("name")
          .eq("id", celebratedGoalId)
          .eq("user_id", user.id)
          .maybeSingle()
      ).data;
    celebratedGoalName = celebrated?.name ?? null;
  }

  const { data: assetsData } = await supabase
    .from("assets")
    .select("id, name, amount, category, last_updated_at")
    .eq("user_id", user.id)
    .order("amount", { ascending: false });

  const { data: liabilitiesData } = await supabase
    .from("liabilities")
    .select("id, name, amount")
    .eq("user_id", user.id)
    .order("amount", { ascending: false });

  netWorthAssets = assetsData ?? [];
  netWorthLiabilities = liabilitiesData ?? [];
  netWorth = computeNetWorth(netWorthAssets, netWorthLiabilities);
  netWorthHeadline = getNetWorthHeadline(profile?.relationship_status ?? null);
  hasNetWorthItems = netWorthAssets.length + netWorthLiabilities.length > 0;

  const stalest = getStalestAsset(netWorthAssets);
  if (stalest && isAssetStale(stalest.last_updated_at)) {
    stalestAsset = {
      id: stalest.id,
      name: stalest.name,
      lastUpdatedAt: stalest.last_updated_at,
    };
  }
}

function formatPln(amount: number): string {
  return `${amount.toFixed(2)} zł`;
}

function formatDeadline(value: string | null): string {
  if (!value) return "";
  return formatProjectedMonth(value);
}

function formatProjectedMonth(value: string): string {
  const [year, month] = value.split("-");
  const date = new Date(Number(year), Number(month) - 1, 1);
  return date.toLocaleDateString("en-GB", { month: "long", year: "numeric" });
}

function progressPercent(saved: number, target: number): number {
  if (target <= 0) return 0;
  return Math.min(saved / target, 1) * 100;
}

const checkInGoals = activeGoals.map((g) => ({ id: g.id, name: g.name }));
---

<Layout title="Dashboard">
  <div class="bg-warm min-h-screen">
    <div class="relative z-10 p-4 sm:p-8">
      <Topbar />
      <div class="mx-auto mt-8 max-w-2xl">
        <div class="mb-8 text-center">
          <h1 class="text-foreground mb-2 text-3xl font-bold">Dashboard</h1>
          <p class="text-muted-foreground">
            Welcome, <span class="text-foreground font-semibold">{greeting}</span>
          </p>
        </div>

        <NetWorthPanel
          headline={netWorthHeadline}
          netWorth={netWorth}
          assets={netWorthAssets.map((asset) => ({
            id: asset.id,
            name: asset.name,
            amount: asset.amount,
            category: asset.category,
            lastUpdatedAt: asset.last_updated_at,
          }))}
          liabilities={netWorthLiabilities}
          stalestAsset={stalestAsset}
          hasAnyItems={hasNetWorthItems}
          client:load
        />

        <div class="mb-4 flex items-center justify-between gap-3">
          <h2 class="text-foreground text-lg font-semibold">Active goals</h2>
          <div class="flex items-center gap-2">
            <CheckInModal goals={checkInGoals} defaultMonth={defaultMonth} client:load />
            <a
              href="/goals/new"
              class="border-primary/30 bg-primary/10 text-primary hover:bg-primary/20 rounded-lg border px-3 py-1.5 text-sm transition-colors"
            >
              Add goal
            </a>
          </div>
        </div>

        {
          activeGoals.length > 0 ? (
            <ul class="space-y-4">
              {activeGoals.map((goal) => {
                const pct = progressPercent(goal.saved_amount, goal.target_amount);
                const metrics = metricsByGoal[goal.id];
                return (
                  <li class="border-border bg-card rounded-xl border p-5 shadow-sm transition-shadow hover:shadow-md">
                    <div class="mb-3 flex items-start justify-between gap-4">
                      <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center gap-2">
                          <a
                            href={`/goals/${goal.id}`}
                            class="text-foreground hover:text-primary font-medium transition-colors"
                          >
                            {goal.name}
                          </a>
                          {metrics.status && <GoalStatusBadge status={metrics.status} />}
                        </div>
                        <p class="text-muted-foreground mt-1 text-sm">
                          {formatPln(goal.saved_amount)} / {formatPln(goal.target_amount)}
                        </p>
                        {goal.deadline && (
                          <p class="text-muted-foreground/70 mt-1 text-xs">Deadline: {formatDeadline(goal.deadline)}</p>
                        )}
                        {metrics.requiredPace != null && (
                          <p class="text-muted-foreground/80 mt-1 text-xs">
                            Required pace: {formatPln(metrics.requiredPace)}/mo
                          </p>
                        )}
                        {metrics.projectedCompletionDate && (
                          <p class="text-muted-foreground/80 mt-1 text-xs">
                            Projected: {formatProjectedMonth(metrics.projectedCompletionDate)}
                            <span class="text-muted-foreground/60">
                              (based on {formatMonthsOfData(metrics.monthsOfData)} of data)
                            </span>
                          </p>
                        )}
                      </div>
                      <div class="flex shrink-0 items-center gap-2">
                        <GoalQuickPayment
                          goalId={goal.id}
                          goalName={goal.name}
                          defaultMonth={defaultMonth}
                          client:load
                        />
                        <a
                          href={`/goals/${goal.id}/edit`}
                          class="text-primary hover:text-primary/80 text-sm transition-colors"
                        >
                          Edit
                        </a>
                      </div>
                    </div>
                    <div class="bg-muted h-2 overflow-hidden rounded-full">
                      <div class="bg-primary h-full rounded-full transition-all" style={`width: ${pct}%`} />
                    </div>
                    <p class="text-muted-foreground/70 mt-1 text-right text-xs">{pct.toFixed(0)}%</p>
                  </li>
                );
              })}
            </ul>
          ) : (
            <div class="border-border bg-card rounded-xl border p-8 text-center shadow-sm">
              <p class="text-muted-foreground mb-4">No active goals yet. Start saving toward something meaningful.</p>
              <a
                href="/goals/new"
                class="border-primary/30 bg-primary/10 text-primary hover:bg-primary/20 inline-block rounded-lg border px-4 py-2 text-sm transition-colors"
              >
                Add goal
              </a>
            </div>
          )
        }
      </div>
    </div>

    {celebratedGoalId && <CelebrationModal goalId={celebratedGoalId} goalName={celebratedGoalName} client:load />}
  </div>
</Layout>
