---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import CelebrationModal from "@/components/goals/CelebrationModal";
import { createClient } from "@/lib/supabase";

const { user, profile } = Astro.locals;
const greeting = profile?.display_name ?? user?.email;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const celebratedGoalId = Astro.url.searchParams.get("celebrated");

let activeGoals: {
  id: string;
  name: string;
  saved_amount: number;
  target_amount: number;
  deadline: string | null;
}[] = [];

let celebratedGoalName: string | null = null;

if (supabase && user) {
  const { data } = await supabase
    .from("savings_goals")
    .select("id, name, saved_amount, target_amount, deadline")
    .eq("user_id", user.id)
    .eq("status", "active")
    .order("created_at", { ascending: false });

  activeGoals = data ?? [];

  if (celebratedGoalId) {
    const celebrated =
      activeGoals.find((g) => g.id === celebratedGoalId) ??
      (
        await supabase
          .from("savings_goals")
          .select("name")
          .eq("id", celebratedGoalId)
          .eq("user_id", user.id)
          .maybeSingle()
      ).data;
    celebratedGoalName = celebrated?.name ?? null;
  }
}

function formatPln(amount: number): string {
  return `${amount.toFixed(2)} zł`;
}

function formatDate(value: string | null): string {
  if (!value) return "";
  return new Date(value).toLocaleDateString("pl-PL");
}

function progressPercent(saved: number, target: number): number {
  if (target <= 0) return 0;
  return Math.min(saved / target, 1) * 100;
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen">
    <div class="relative z-10 p-4 sm:p-8">
      <Topbar />
      <div class="mx-auto mt-8 max-w-2xl">
        <div class="mb-8 text-center">
          <h1
            class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent"
          >
            Dashboard
          </h1>
          <p class="text-blue-100/80">
            Welcome, <span class="font-semibold text-white">{greeting}</span>
          </p>
        </div>

        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-white">Active goals</h2>
          <a
            href="/goals/new"
            class="rounded-lg border border-purple-400/40 bg-purple-900/30 px-3 py-1.5 text-sm text-purple-200 transition-colors hover:bg-purple-900/50"
          >
            Add goal
          </a>
        </div>

        {
          activeGoals.length > 0 ? (
            <ul class="space-y-4">
              {activeGoals.map((goal) => {
                const pct = progressPercent(goal.saved_amount, goal.target_amount);
                return (
                  <li class="rounded-xl border border-white/10 bg-white/10 p-5 text-white backdrop-blur-xl">
                    <div class="mb-3 flex items-start justify-between gap-4">
                      <div>
                        <h3 class="font-medium">{goal.name}</h3>
                        <p class="mt-1 text-sm text-blue-100/70">
                          {formatPln(goal.saved_amount)} / {formatPln(goal.target_amount)}
                        </p>
                        {goal.deadline && (
                          <p class="mt-1 text-xs text-blue-100/50">Deadline: {formatDate(goal.deadline)}</p>
                        )}
                      </div>
                      <a
                        href={`/goals/${goal.id}/edit`}
                        class="shrink-0 text-sm text-purple-300 transition-colors hover:text-purple-100"
                      >
                        Edit
                      </a>
                    </div>
                    <div class="h-2 overflow-hidden rounded-full bg-white/10">
                      <div
                        class="h-full rounded-full bg-gradient-to-r from-blue-400 to-purple-400 transition-all"
                        style={`width: ${pct}%`}
                      />
                    </div>
                    <p class="mt-1 text-right text-xs text-blue-100/50">{pct.toFixed(0)}%</p>
                  </li>
                );
              })}
            </ul>
          ) : (
            <div class="rounded-xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
              <p class="mb-4 text-blue-100/70">No active goals yet. Start saving toward something meaningful.</p>
              <a
                href="/goals/new"
                class="inline-block rounded-lg border border-purple-400/40 bg-purple-900/30 px-4 py-2 text-sm text-purple-200 transition-colors hover:bg-purple-900/50"
              >
                Add goal
              </a>
            </div>
          )
        }
      </div>
    </div>

    {celebratedGoalId && <CelebrationModal goalId={celebratedGoalId} goalName={celebratedGoalName} client:load />}
  </div>
</Layout>
