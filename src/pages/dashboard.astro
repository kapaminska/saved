---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";

const { user, profile } = Astro.locals;
const greeting = profile?.display_name ?? user?.email;
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen">
    <div class="relative z-10 p-4 sm:p-8">
      <Topbar />
      <div class="mx-auto mt-8 flex max-w-4xl flex-col items-center justify-center text-center">
        <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
          <h1
            class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent"
          >
            Dashboard
          </h1>
          <p class="text-blue-100/80">
            Welcome, <span class="font-semibold text-white">{greeting}</span>
          </p>
          <p class="mt-2 text-sm text-blue-100/50">This page is only for authenticated users.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
